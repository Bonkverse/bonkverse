# Copy to .env for local development. Every setting is read in
# bonk_skin_search/settings.py; production sets these in Railway.

ENV=local
SECRET_KEY=dev-insecure-secret-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/bonkverse
REDIS_URL=redis://localhost:6379/0

# Log level for this app's loggers (skins.*, core.*): DEBUG, INFO, WARNING.
# LOG_LEVEL=INFO

# --- Other Bonkverse services (defaults shown) ---
# Public address of this site, for the few places that need an absolute URL.
# BONKVERSE_BASE_URL=https://bonkverse.io
# "Skin Editor" and "Replays" links: your local dev servers for those apps.
# BONKVERSE_EDITOR_URL=http://localhost:5173
# BONKVERSE_REPLAYS_URL=http://localhost:5173
# Skin renderer used by staff re-render. Production's works fine locally.
# BONKVERSE_RENDER_URL=https://editor.bonkverse.io
# BonkLeagues skin fetcher (upload) and BonkBot API (matchmaking).
# BLSKIN_FETCHER_URL=https://blskinfetcher-production.up.railway.app/api/getSkin
# BONKBOT_API_URL=https://bonkbot-api-production.up.railway.app
# Map decoder (Tools -> Map Decoder). Leave unset to show "not available".
# DECODER_SERVICE_URL=
# DECODER_SERVICE_KEY=

# --- bonk.io login ---
# BONK_CONNECT_TIMEOUT=4
# BONK_READ_TIMEOUT=8
# SYNC_FRIENDS_ON_LOGIN=1
